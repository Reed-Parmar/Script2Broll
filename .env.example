# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# All keys are used by the backend only and are never sent to the frontend.

# PostgreSQL + pgvector (matches docker-compose.yml defaults). If port 5432 is already taken
# (e.g. a native PostgreSQL), set POSTGRES_PORT=5433 and use :5433 in DATABASE_URL.
DATABASE_URL=postgresql+psycopg://script2broll:script2broll@localhost:5432/script2broll

# Gemini: LLM, and embeddings if EMBEDDING_PROVIDER=gemini (https://aistudio.google.com/apikey).
# Not needed for search with the default local CLIP provider.
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash

# Language model for editorial-intent analysis (never used for embeddings):
# gemini (needs GEMINI_API_KEY with billing) or ollama (local server, https://ollama.com;
# run `ollama pull <OLLAMA_MODEL>` first).
LLM_PROVIDER=gemini
# OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Embedding space. Changing any of these requires re-embedding the library
# (and a schema change if EMBEDDING_DIM changes).
# clip (local OpenCLIP, model = <architecture>/<pretrained tag>; ViT-B-32 is 512-dim), or
# gemini (EMBEDDING_MODEL=gemini-embedding-2, EMBEDDING_DIM=768; needs Gemini billing).
EMBEDDING_PROVIDER=clip
EMBEDDING_MODEL=ViT-B-32/laion2b_s34b_b79k
EMBEDDING_DIM=512

# Pixabay video source (https://pixabay.com/api/docs/)
PIXABAY_API_KEY=

# Ingestion: where clips/thumbnails are stored (default: <repo>/data, git-ignored)
# and how many frames are sampled per clip for its visual embedding.
# DATA_DIR=
FRAMES_PER_VIDEO=8

# Allowed browser origins for the API (JSON list)
CORS_ORIGINS=["http://localhost:5173"]
